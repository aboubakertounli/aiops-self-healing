# Copy to .env on the AIOps-Agent VM. Never commit the real .env.

PROMETHEUS_URL=http://172.16.99.51:30090
KUBECONFIG_FILE=./kubeconfig

# Empty allowlist = every namespace except kube-system.
RESTART_NAMESPACES=
RESTART_COOLDOWN_SECONDS=300

# OpenRouter: free account, no credit card. :free models share about 50 requests/day.
# Create a key at https://openrouter.ai/keys. Spring calls {base}/v1/chat/completions.
OPENAI_API_KEY=replace-with-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GPU on the CentOS host, instead of the three lines above:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://172.16.99.1:11434
# OPENAI_MODEL=qwen2.5:7b
